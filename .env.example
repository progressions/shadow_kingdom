# Database Configuration
DATABASE_URL=file:./data/shadow_kingdom.db

# Claude AI Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MOCK_MODE=false
CLAUDE_RATE_LIMIT=5

# Development Settings
NODE_ENV=development
AI_DEBUG_LOGGING=false
DEBUG_COMMANDS=false
DEBUG_LOGGING=false

# Logging Configuration
LOG_ENABLED=true
LOG_PATH=log/development.log
LOG_SILENT_ERRORS=false

# Game Engine Settings
GAME_ENGINE_SKIP_MENU=true
GAME_ENGINE_AUTO_CREATE=true
GAME_ENGINE_SHOW_MESSAGES=true
GAME_ENGINE_UPDATE_TIMESTAMPS=true
GAME_ENGINE_BACKGROUND_GEN=true